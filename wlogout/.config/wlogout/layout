{
    "label": "lock",
    "action": "loginctl lock-session",
    "text": "Khóa",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "hyprctl dispatch 'hl.dsp.exit()'",
    "text": "Đăng xuất",
    "keybind": "e"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Ngủ",
    "keybind": "u"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Khởi động lại",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Tắt máy",
    "keybind": "s"
}
