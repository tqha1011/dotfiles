/* Launcher (SUPER+R / SUPER+Space) — kính mờ TokyoNight, một cột, dòng đang chọn có vạch accent bên trái
 * (cùng motif với chấm workspace trên waybar). Màu: shared/colors.rasi do theme-render.py sinh ra.
 * clipboard.rasi kế thừa file này. */

configuration {
    modi:                  "drun,run,window,filebrowser";
    show-icons:            true;
    icon-theme:            "Tela-dark";
    drun-display-format:   "{name}<span alpha='45%' size='small'>   {generic}</span>";
    window-format:         "{c}<span alpha='45%' size='small'>   {t}</span>";
    display-drun:          "Ứng dụng";
    display-run:           "Lệnh";
    display-window:        "Cửa sổ";
    display-filebrowser:   "Tệp";
    hover-select:          true;
    me-select-entry:       "";
    me-accept-entry:       "MousePrimary";
}

@import "shared/colors.rasi"

* {
    font:             "Inter 12";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    location:         center;
    anchor:           center;
    width:            620px;
    transparency:     "real";
    border:           1px;
    border-color:     @hairline;
    border-radius:    16px;
    background-color: @glass;
}

mainbox {
    padding:  0px;
    spacing:  0px;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* ---- Ô tìm kiếm: lớn, im lặng ---- */

inputbar {
    padding:      18px 22px;
    spacing:      14px;
    border:       0px 0px 1px 0px;
    border-color: @hairline;
    children:     [ "icon-search", "entry", "prompt" ];
}

icon-search {
    expand:            false;
    filename:          "search";
    size:              20px;
    vertical-align:    0.5;
}

entry {
    font:              "Inter 15";
    placeholder:       "Tìm…";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

/* Tên chế độ hiện tại ở góc phải ô tìm kiếm */
prompt {
    font:           "Inter 11";
    text-color:     @muted;
    vertical-align: 0.5;
}

message {
    padding: 10px 22px 0px 22px;
}

textbox {
    font:       "Inter 10";
    text-color: @muted;
}

/* ---- Danh sách ---- */

listview {
    columns:      1;
    lines:        8;
    fixed-height: true;
    dynamic:      true;
    cycle:        true;
    scrollbar:    false;
    padding:      10px;
    spacing:      2px;
}

element {
    padding:       9px 14px 9px 12px;
    spacing:       14px;
    border:        0px 0px 0px 3px;
    border-color:  transparent;
    border-radius: 10px;
    cursor:        pointer;
}

/* Điểm nhấn duy nhất: dòng đang chọn — nền surface + vạch accent bên trái */
element selected.normal,
element selected.active {
    background-color: @background-alt;
    border-color:     @selected;
}

element selected.urgent {
    background-color: @background-alt;
    border-color:     @urgent;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    text-color: @active;
}

element-icon {
    size:           28px;
    cursor:         inherit;
    vertical-align: 0.5;
}

element-text {
    markup:         true;
    cursor:         inherit;
    vertical-align: 0.5;
    text-color:     inherit;
}

/* ---- Chuyển chế độ: chữ nhỏ ở đáy, chế độ đang mở màu accent ---- */

mode-switcher {
    padding:      10px 14px 12px 14px;
    spacing:      4px;
    border:       1px 0px 0px 0px;
    border-color: @hairline;
}

button {
    font:          "Inter 10";
    padding:       6px 12px;
    border-radius: 8px;
    text-color:    @muted;
    cursor:        pointer;
}

button selected {
    background-color: @background-alt;
    text-color:       @selected;
}
