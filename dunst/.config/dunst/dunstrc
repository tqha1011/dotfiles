# TokyoNight Night — cùng bảng màu với rofi/shared/colors.rasi và ghostty
# Nền có alpha (e6) để Hyprland blur phía sau (layer rule "notifications")
# Xem đầy đủ option: man 5 dunst

[global]
    monitor = 0
    follow = mouse

    # Kích thước & vị trí: góc trên phải, thẳng hàng mép trên cửa sổ
    # (waybar 10 + 34 = 44px, cộng gaps_out 20 của Hyprland)
    width = (280, 380)
    height = (0, 300)
    origin = top-right
    offset = (20, 64)
    notification_limit = 5
    gap_size = 8

    # Thanh tiến trình (volume/brightness gửi kèm hint value)
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 380
    progress_bar_corner_radius = 4

    # Khung — bo góc khớp với decoration.rounding của Hyprland
    corner_radius = 10
    frame_width = 2
    separator_height = 2
    separator_color = frame
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    # Chữ
    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icon
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # Lịch sử (dunstctl history-pop)
    sticky_history = yes
    history_length = 20

    # Chuột: trái = mở action/đóng, giữa = đóng hết, phải = đóng
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

    browser = /usr/bin/xdg-open
    dmenu = /usr/bin/rofi -dmenu -p dunst -theme ~/.config/rofi/launcher.rasi

[urgency_low]
    background = "#1a1b26e6"
    foreground = "#a9b1d6"
    frame_color = "#292e42"
    highlight = "#7aa2f7"
    timeout = 4

[urgency_normal]
    background = "#1a1b26e6"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    highlight = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1a1b26e6"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0

# Ảnh chụp màn hình từ hyprshot: viền vàng + thumbnail lớn (icon chính là ảnh vừa chụp)
[hyprshot]
    appname = Hyprshot
    frame_color = "#e0af68"
    max_icon_size = 128

# OSD âm lượng/độ sáng từ hypr/scripts/osd.sh: gọn, không vào lịch sử
[osd]
    appname = OSD
    format = "<b>%s</b>"
    frame_color = "#292e42"
    history_ignore = yes
    min_icon_size = 0
    max_icon_size = 0
