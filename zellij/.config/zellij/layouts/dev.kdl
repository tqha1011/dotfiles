// Layout cho dự án (zp / SUPER+O): shell, chạy server, git
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    tab name="shell" focus=true {
        pane
    }
    tab name="run" {
        pane
    }
    tab name="git" {
        pane command="lazygit"
    }
}
