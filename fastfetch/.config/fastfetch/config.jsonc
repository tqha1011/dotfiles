{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.local/share/ascii/chainsawman-logo2.png",
    "color": {
      "1": "bright_",
    },
    "padding": {
      "top": 2,
      "right": 3,
    },
    "width": 20,
    "height": 15,
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": " {user-name}@{host-name}",
      "keyWidth": 10,
    },
    {
      "type": "separator",
      "string": "·· •· •· •· •· •· ··",
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "33", // = color3
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "33",
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "33",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "33",
    },
    {
      "type": "cpu",
      "key": "󰻠 ",
      "keyColor": "33",
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "33",
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "format": "{used}/{total}",
      "keyColor": "33",
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "format": "{size-used}/{size-total}",
      "keyColor": "33",
    },

    "break",
    "colors",
    "break",
    "break",
  ],
}
