{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.local/share/ascii/chainsawman-logo2.png",
    "color": {
      "1": "bright_",
    },
    "padding": {
      "top": 1,
      "right": 3,
    },
    "width": 20,
    "height": 15,
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 0,
    },
    "color": {
      "keys": "blue",
      "output": "white",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;35}󰣇 {user-name}{#90}@{#1;34}{host-name}",
    },
    "break",

    // Khối "Hệ thống": thanh dọc bên trái thay cho khung kín (độ dài giá trị đổi theo máy nên không đóng khung phải)
    { "type": "custom", "format": "{#34}╭─ {#1;34}Hệ thống" },
    { "type": "os",       "key": "{#34}│ {#33}  ", "format": "{name} {#90}{arch}" },
    { "type": "kernel",   "key": "{#34}│ {#33}  " },
    { "type": "uptime",   "key": "{#34}│ {#33}󰔛  " },
    { "type": "packages", "key": "{#34}│ {#33}󰏖  " },
    { "type": "shell",    "key": "{#34}│ {#33}  " },
    { "type": "wm",       "key": "{#34}│ {#33}  " },
    { "type": "terminal", "key": "{#34}│ {#33}  " },
    { "type": "custom", "format": "{#34}╰─" },

    // Khối "Phần cứng"
    { "type": "custom", "format": "{#35}╭─ {#1;35}Phần cứng" },
    { "type": "cpu",    "key": "{#35}│ {#36}󰻠  ", "format": "{name} {#90}{cores-physical}c/{cores-logical}t" },
    { "type": "gpu",    "key": "{#35}│ {#36}󰢮  ", "format": "{name}" },
    { "type": "memory", "key": "{#35}│ {#36}󰍛  ", "format": "{used} / {total} {#90}({percentage})" },
    { "type": "disk",   "key": "{#35}│ {#36}󰋊  ", "format": "{size-used} / {size-total} {#90}({size-percentage})" },
    { "type": "custom", "format": "{#35}╰─" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 },
    "break",
  ],
}
