{
  "layer": "top",
  "reload_style_on_change": true, // tự reload khi style.css / colors.css đổi (thay cho auto-reload.sh cũ)
  "height": 34,
  "margin-top": 10,
  "margin-left": 20,
  "margin-right": 20,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "cpu",
    "group/audio",
    "network",
    "bluetooth",
    "battery",
    "clock",
    "group/group-power",
  ],

  // Chấm workspace: nhãn rỗng, CSS vẽ chấm và giãn chấm active thành vạch
  "hyprland/workspaces": {
    "format": "",
    "persistent-workspaces": {
      "*": 5,
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
  },

  "hyprland/window": {
    "icon": true,
    "icon-size": 16,
    "max-length": 50,
    "separate-outputs": true,
  },

  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "states": {
      "warning": 70,
      "critical": 90,
    },
  },

  // Drawer: hover vào icon loa thì slider trượt ra
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "audio-child",
    },
    "modules": ["pulseaudio", "pulseaudio/slider"],
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "scroll-step": 1,
    "ignored-sinks": ["Easy Effects Sink"],
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },

  "network": {
    "interface": "wlan0",
    "format": "󰖩",
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "ghostty --class=floating.nmtui -e nmtui",
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "", // an empty format will hide the module
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager",
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "smooth-power": true,
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d/%m  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#c0caf5'><b>{}</b></span>",
        "days": "<span color='#a9b1d6'>{}</span>",
        "weekdays": "<span color='#565f89'>{}</span>",
        "today": "<span color='#7aa2f7'><b><u>{}</u></b></span>",
      },
    },
  },

  "group/group-power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-power",
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/power", // First element is the "group leader" and won't ever be hidden
      "custom/quit",
      "custom/lock",
      "custom/reboot",
    ],
  },
  "custom/quit": {
    "format": "󰗼",
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.exit()'",
  },
  "custom/lock": {
    "format": "󰍁",
    "tooltip": false,
    "on-click": "loginctl lock-session",
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip": false,
    "on-click": "reboot",
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "shutdown now",
  },
}
